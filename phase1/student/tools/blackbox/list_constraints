#!/usr/bin/env python3
"""list_constraints: list the numeric constraints in SPEC.md and their boundary values.

Usage: list_constraints

For each line like `1 <= n <= 100` it prints the values at and next to each bound.
Values outside the range are not valid inputs, so they are not suggested.
"""

import re
import sys
from pathlib import Path

NUMBER = r"-?\d+(?:\s*\*\s*10\^\d+|\^\d+)?"
PATTERN = re.compile(rf"({NUMBER})\s*(<=|<)\s*(.+?)\s*(<=|<)\s*({NUMBER})")


def to_int(text: str) -> int:
    """Parse numbers like 100, -1000, 10^5 or 2 * 10^5."""
    text = text.replace(" ", "")
    if "*10^" in text:
        base, exp = text.split("*10^")
        return int(base) * 10 ** int(exp)
    if "^" in text:
        base, exp = text.split("^")
        magnitude = abs(int(base)) ** int(exp)
        return -magnitude if base.startswith("-") else magnitude
    return int(text)


def main() -> int:
    if "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0
    spec = Path("SPEC.md").read_text()
    found = 0
    for line in spec.splitlines():
        match = PATTERN.search(line)
        if not match:
            continue
        low, left, name, right, high = match.groups()
        low = to_int(low) + (left == "<")
        high = to_int(high) - (right == "<")
        if low > high:
            continue
        found += 1
        boundaries = sorted({low, min(low + 1, high), max(high - 1, low), high})
        print(f"{name.strip()}: [{low}, {high}]  boundaries: {', '.join(map(str, boundaries))}")
    if not found:
        print("No numeric constraints found in SPEC.md.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
