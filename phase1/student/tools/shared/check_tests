#!/usr/bin/env python3
"""check_tests: check that the test files in ./tests are valid without running them.

Usage: check_tests [--max-calls N]

Reports syntax errors, collection errors, the number of collected tests, test functions
that contain no assertion, tests that duplicate each other, a suite larger than the call
budget, and anything that makes the evaluator reject a file (for example importing os or
inspect, calling open, or mentioning solution.py).

--max-calls N warns when there are more tests than the evaluator measures.
"""

import ast
import subprocess
import sys
from pathlib import Path

# Keep the tool standalone: task rules forbid importing harness internals.
FORBIDDEN_MODULES = {
    "inspect", "os", "io", "pathlib", "importlib", "linecache", "dis", "subprocess",
    "shutil", "glob", "marshal", "ast", "tokenize", "pkgutil", "runpy",
}
FORBIDDEN_NAMES = {"open", "exec", "eval", "compile", "globals", "vars", "__import__", "breakpoint"}
FORBIDDEN_ATTRS = {
    "__code__", "__file__", "__globals__", "__dict__", "__loader__", "__spec__", "modules",
    "getsource", "getsourcelines", "read_text", "read_bytes",
}


def source_access(path: Path) -> str:
    try:
        tree = ast.parse(path.read_text())
    except SyntaxError:
        return ""
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names = {alias.name.split(".")[0] for alias in node.names}
        elif isinstance(node, ast.ImportFrom):
            names = {(node.module or "").split(".")[0]}
        else:
            names = set()
        hit = names & FORBIDDEN_MODULES
        if hit:
            return f"imports {sorted(hit)[0]}"
        if isinstance(node, ast.Name) and node.id in FORBIDDEN_NAMES:
            return f"uses {node.id}"
        if isinstance(node, ast.Attribute) and node.attr in FORBIDDEN_ATTRS:
            return f"uses .{node.attr}"
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and "solution.py" in node.value:
            return "mentions solution.py"
    return ""


def has_assertion(func: ast.AST) -> bool:
    """True if the function contains an assert, pytest.raises or an assert* call."""
    for node in ast.walk(func):
        if isinstance(node, ast.Assert):
            return True
        if isinstance(node, ast.With) and any("raises" in ast.unparse(i.context_expr) for i in node.items):
            return True
        if isinstance(node, ast.Call) and "assert" in ast.unparse(node.func):
            return True
    return False


def body_key(func: ast.AST) -> str:
    """Structure of a test's arguments and body, ignoring its name and line numbers."""
    return ast.dump(func.args) + "|" + "|".join(ast.dump(statement) for statement in func.body)


def main() -> int:
    if "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0
    max_calls = 0
    if "--max-calls" in sys.argv[1:]:
        max_calls = int(sys.argv[sys.argv.index("--max-calls") + 1])
    files = sorted(Path("tests").glob("test_*.py"))
    if not files:
        print("No test files found in ./tests (expected tests/test_*.py).")
        return 1
    problems = 0
    seen = {}
    for path in files:
        try:
            tree = ast.parse(path.read_text())
        except SyntaxError as error:
            print(f"{path}: syntax error on line {error.lineno}: {error.msg}")
            problems += 1
            continue
        reason = source_access(path)
        if reason:
            print(f"{path}: the evaluator will reject this whole file because it {reason}")
            problems += 1
        for node in ast.walk(tree):
            if isinstance(node, ast.FunctionDef) and node.name.startswith("test"):
                if not has_assertion(node):
                    print(f"{path}::{node.name} has no assertion")
                    problems += 1
                key = body_key(node)
                if key in seen:
                    print(f"{path}::{node.name} duplicates {seen[key]}")
                    problems += 1
                else:
                    seen[key] = f"{path.name}::{node.name}"
    result = subprocess.run(
        [sys.executable, "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider", "tests"],
        capture_output=True,
        text=True,
        timeout=120,
    )
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    collected = [line for line in lines if "::" in line]
    print(f"Collected {len(collected)} tests.")
    if max_calls and len(collected) > max_calls:
        print(f"Warning: only the first {max_calls} calls are measured and you have {len(collected)} tests "
              f"(each test spends at least one call). Cut duplicates or low-value tests.")
        problems += 1
    if result.returncode not in (0, 5):
        print("\n".join(lines[-30:]))
        problems += 1
    print("OK" if problems == 0 else f"{problems} problem(s) found.")
    return 0 if problems == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
