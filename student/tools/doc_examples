#!/usr/bin/env python3
"""doc_examples: turn the examples in the documentation and docstrings into tests.

Usage: doc_examples

Each example (`>>> call` followed by its documented result) becomes a one-check test. Examples the
code does not reproduce are strong evidence of a bug; they are kept and also used to seed the repair
check. Run it once, early."""

import os
import sys
from pathlib import Path

os.environ.setdefault("MSWEA_SILENT_STARTUP", "1")

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))


def main() -> int:
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        return 0
    from tagent.session import Session
    s = Session()
    print(s.op_doc_examples())
    return 0


if __name__ == "__main__":
    sys.exit(main())
