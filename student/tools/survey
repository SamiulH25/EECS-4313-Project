#!/usr/bin/env python3
"""survey: list the package's units (classes / function groups), highest risk first.

Usage: survey

For each unit: its id, how many risk points (comparisons, constants and branches where a small injected
bug would sit) it has, whether the fuzzer could drive it, how many rounds of your own tests it has had
and how many of them were confirmed, and how many of its branches no test has reached yet."""

import os
import sys
from pathlib import Path

os.environ.setdefault("MSWEA_SILENT_STARTUP", "1")

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))


def main() -> int:
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        return 0
    from tagent.session import Session
    s = Session()
    print(s.op_survey())
    return 0


if __name__ == "__main__":
    sys.exit(main())
